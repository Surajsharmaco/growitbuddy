{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/render?path=/"
    },
    {
      "source": "/acts-club",
      "destination": "/acts-club/index.html"
    },
    {
      "source": "/acts-club/",
      "destination": "/acts-club/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/render?path=/$1"
    }
  ]
}
